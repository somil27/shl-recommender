LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
ENVIRONMENT=development
DEBUG=true
PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
VECTOR_DB_PATH=data/vector_store
CATALOG_PATH=data/assessments.json
CACHE_SIZE=100
CACHE_TTL=3600
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=25
LOG_LEVEL=INFO
LOG_FILE=logs/app.log